<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <Nullable>disable</Nullable> <!-- TODO: Make nullable the default -->
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration) == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <PackageTags>swallow;validation;fluent;extensible;lightweight</PackageTags>
    <Description>
      A lightweight, fluent and extensible validation library that allows you to specify validations right where you need them.
      No extra classes needed, strongly typed errors and extensibility built right into the core.
    </Description>

    <Authors>Philipp Kiener</Authors>
    <Copyright>2019-2026 Philipp Kiener</Copyright>
    <PackageProjectUrl>https://github.com/phkiener/Swallow.Validation</PackageProjectUrl>

    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/phkiener/Swallow.Validation</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup Label="Package files">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE.txt" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
